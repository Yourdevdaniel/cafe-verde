# Copy to .env and set SECRET_KEY and POSTGRES_PASSWORD before running.
# Docker Compose reads this file for the db and backend services.

# Django
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
# 1 = development. With 0, Django forces HTTPS, secure cookies and HSTS.
DEBUG=1
# "backend" is needed because the Vite dev server proxies /api and /ws to backend:8000
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=cafeteria
POSTGRES_USER=cafeteria
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (Channels layer)
REDIS_HOST=redis

# Initial staff passwords, used by `manage.py seed` only when the user does not exist yet.
# Leave one empty and the seed generates a random password and prints it once in the
# backend log (docker compose logs backend).
ADMIN_PASSWORD=
COZINHA_PASSWORD=
GARCOM_PASSWORD=
